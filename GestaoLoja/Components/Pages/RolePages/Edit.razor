@page "/roles/edit/{roleId}"
@using Microsoft.AspNetCore.Identity
@inject RoleManager<IdentityRole> RoleManager
@inject NavigationManager Navigation

<PageTitle>Editar Role</PageTitle>

<h3>Editar Role</h3>

@if (role == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <EditForm method="post" Model="role" OnValidSubmit="HandleValidSubmit" FormName="edit" Enhance>
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="form-group">
            <label for="Name">Name</label>
            <InputText id="Name" class="form-control" @bind-Value="role.Name" />
        </div>
        <button type="submit" class="btn btn-primary">Save</button>
        <a href="/roles" class="btn btn-secondary">Cancel</a>
    </EditForm>
}

@code {
    [SupplyParameterFromQuery]
    public string roleId { get; set; }

    private IdentityRole role;

    protected override async Task OnInitializedAsync()
    {
        role = await RoleManager.FindByIdAsync(roleId);
        if (role == null)
        {
            Navigation.NavigateTo("/notfound");
        }
    }

    private async Task HandleValidSubmit()
    {
        await RoleManager.UpdateAsync(role);
        Navigation.NavigateTo("/roles");
    }
}
