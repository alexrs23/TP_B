@page "/roles/assign"
@using Microsoft.AspNetCore.Identity.EntityFrameworkCore
@using Microsoft.AspNetCore.Identity
@using GestaoLoja.Data
@using Microsoft.EntityFrameworkCore
@inject UserManager<ApplicationUser> UserManager
@inject RoleManager<IdentityRole> RoleManager
@inject NavigationManager Navigation

<PageTitle>Atribuir Roles</PageTitle>

<h3>Atribuir Roles</h3>

@if (users == null || roles == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>User</th>
                <th>Roles</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in users)
            {
                <tr>
                    <td>@user.UserName</td>
                    <td>
                        @foreach (var role in roles)
                        {
                            <div class="form-check">
                                <!--
                                <input class="form-check-input" type="checkbox" id="@($"{user.Id}-{role.Name}")" @onchange="(e) => ToggleRole(user, role, ((ChangeEventArgs)e).Value.ToString().ToLower() ==  "true")" checked="@userRoles[user.Id].Contains(role.Name)" />
                                -->
                                <label class="form-check-label" for="@($"{user.Id}-{role.Name}")">@role.Name</label>
                            </div>
                        }
                    </td>
                    <td>
                        <button class="btn btn-primary" @onclick="() => SaveRoles(user)">Save</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<ApplicationUser> users;
    private List<IdentityRole> roles;
    private Dictionary<string, List<string>> userRoles = new();

    protected override async Task OnInitializedAsync()
    {
        users = await UserManager.Users.ToListAsync();
        roles = await RoleManager.Roles.ToListAsync();

        foreach (var user in users)
        {
            var userRoleNames = await UserManager.GetRolesAsync(user);
            userRoles[user.Id] = userRoleNames.ToList();
        }
    }

    private void ToggleRole(ApplicationUser user, IdentityRole role, bool isSelected)
    {
        if (isSelected)
        {
            if (!userRoles[user.Id].Contains(role.Name))
            {
                userRoles[user.Id].Add(role.Name);
            }
        }
        else
        {
            if (userRoles[user.Id].Contains(role.Name))
            {
                userRoles[user.Id].Remove(role.Name);
            }
        }
    }

    private async Task SaveRoles(ApplicationUser user)
    {
        var currentRoles = await UserManager.GetRolesAsync(user);
        var rolesToAdd = userRoles[user.Id].Except(currentRoles).ToList();
        var rolesToRemove = currentRoles.Except(userRoles[user.Id]).ToList();

        await UserManager.AddToRolesAsync(user, rolesToAdd);
        await UserManager.RemoveFromRolesAsync(user, rolesToRemove);

        Navigation.NavigateTo("/roles/assign");
    }
}
