@page "/utilizadores/assign"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Identity.EntityFrameworkCore
@using Microsoft.EntityFrameworkCore
@using GestaoLoja.Data

@inject UserManager<ApplicationUser> UserManager
@inject RoleManager<IdentityRole> RoleManager
@inject NavigationManager NavigationManager
@inject ILogger<Assign> Logger

@rendermode InteractiveServer

<h3>Atribuir Roles aos Usuários</h3>

@if (users == null || roles == null)
{
	<p>Carregando...</p>
}
else
{
	<button class="btn-primary" @onclick="TestarClique">Atualizar Roles</button>
	<table class="table">
		<thead>
			<tr>
				<th>Email</th>
				<th>Usuário</th>
				<th>Role Atual</th>
				<th>Nova Role</th>
				<th>Ação</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var user in users)
			{
				<tr>
					<td>@user.Email</td>
					<td>@user.UserName</td>
					<td>@userRoles[user.Id]</td>

					<td>
						<select @bind="userRoles[user.Id]" class="form-select">
							<option value="">Selecione uma role</option>
							@foreach (var role in roles)
							{
								<option value="@role.Name">@role.Name</option>
							}
						</select>
					</td>
					<td>
						<button class="btn btn-primary" id="btn-@user.Id" @onclick="async () => await UpdateRole(user.Id)">
							Atribuir Role
						</button>
					</td>
				</tr>
			}
		</tbody>
	</table>
}

@code {
	private List<ApplicationUser>? users;
	private List<IdentityRole>? roles;
	private Dictionary<string, string> userRoles = new();

	private void TestarClique()
	{
		Console.WriteLine("Botão clicado!");
	}

	protected override async Task OnInitializedAsync()
	{
		users = await UserManager.Users.ToListAsync();
		roles = await RoleManager.Roles.ToListAsync();

		foreach (var user in users)
		{
			var currentRole = await UserManager.GetRolesAsync(user);
			userRoles[user.Id] = currentRole.FirstOrDefault() ?? "Nenhum role";
		}
		Console.WriteLine("Usuários e roles carregados com sucesso.");
	}



	private async Task UpdateRole(string userId)
	{
		var user = await UserManager.FindByIdAsync(userId);
		if (user == null)
		{
			Logger.LogError($"Usuário com ID '{userId}' não encontrado.");
			Console.WriteLine($"Usuário com ID '{userId}' não encontrado.");
			return;
		}


		// Remover roles existentes
		var currentRoles = await UserManager.GetRolesAsync(user);
		var removeResult = await UserManager.RemoveFromRolesAsync(user, currentRoles);

		if (!removeResult.Succeeded)
		{
			var errors = string.Join(", ", removeResult.Errors.Select(e => e.Description));
			Logger.LogError($"Erro ao remover roles: {errors}");
			Console.WriteLine($"Erro ao remover roles: {errors}");
			return;
		}

		// Adicionar nova role, se aplicável
		if (!string.IsNullOrEmpty(userRoles[userId]))
		{
			var result = await UserManager.AddToRoleAsync(user, userRoles[userId]);
			if (!result.Succeeded)
			{
				var errors = string.Join(", ", result.Errors.Select(e => e.Description));
				Logger.LogError($"Erro ao adicionar role: {errors}");
				Console.WriteLine($"Erro ao adicionar role: {errors}");
				return;
			}
		}
		
		NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad:true);

	}
}
