@page "/produtos"
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using GestaoLoja.Entities
@using GestaoLoja.Data
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize(Roles = "Admin, Gestor")]

@rendermode InteractiveServer

@implements IAsyncDisposable
@inject IDbContextFactory<GestaoLoja.Data.ApplicationDbContext> DbFactory

<PageTitle>Produtos</PageTitle>

<h1>Produtos</h1>

<p>
    <a href="produtos/create">Criar Novo</a>
</p>

<div>
    <label for="categoria">Categoria:</label>
    <select id="categoria" @bind="selectedCategoria">
        <option value="">Todas</option>
        @foreach (var categoria in categorias)
        {
            <option value="@categoria">@categoria</option>
        }
    </select>

    <label for="disponibilidade">Disponível:</label>
    <input type="checkbox" id="disponibilidade" @bind="disponivel"/>
</div>

<QuickGrid TGridItem="Produto" Class="table" Items="paginatedProdutos.AsQueryable()">
    <TemplateColumn Context="produto">
        <img src="/img/@produto.UrlImagem" alt="Imagem do Produto" style="max-width: 100px; max-height: 100px;" />
    </TemplateColumn>
    <PropertyColumn Property="produto => produto.Nome" />
    <PropertyColumn Property="produto => produto.Detalhe" />
    <PropertyColumn Property="produto => produto.Preco" />
    <PropertyColumn Property="produto => produto.EmStock" />
    <PropertyColumn Property="produto => produto.Disponivel" />
    <PropertyColumn Property="produto => produto.Origem" />
    <!--
    <PropertyColumn Property="produto => produto.CategoriaNome" />
    -->

    <TemplateColumn Context="produto">
        <a href="@($"produtos/edit?id={produto.Id}")">Edit</a> |
        <a href="@($"produtos/details?id={produto.Id}")">Details</a> |
        <a href="@($"produtos/delete?id={produto.Id}")">Delete</a>
    </TemplateColumn>
</QuickGrid>

<div>
    <button @onclick="PreviousPage" disabled="@(!CanGoToPreviousPage)">Anterior</button>
    <span>Página @currentPage de @totalPages</span>
    <button @onclick="NextPage" disabled="@(!CanGoToNextPage)">Próxima</button>
</div>

@code {
    private ApplicationDbContext context = default!;
    private List<Produto> produtos = new();
    private List<string> categorias = new();
    private string selectedCategoria = string.Empty;
    private bool disponivel = false;

    private int currentPage = 1;
    private int pageSize = 4; // Alterado de 10 para 5
    private int totalPages => (int)Math.Ceiling((double)filteredProdutos.Count() / pageSize);

    protected override async Task OnInitializedAsync()
    {
        context = DbFactory.CreateDbContext();
        produtos = await context.Produtos.ToListAsync();
        categorias = produtos.Select(p => p.CategoriaId.ToString()).Distinct().ToList();
    }

    private void OnFilterChanged(ChangeEventArgs e)
    {
        currentPage = 1;
        StateHasChanged();
    }

    private IEnumerable<Produto> filteredProdutos => produtos
    .Where(p => (string.IsNullOrEmpty(selectedCategoria) || p.CategoriaId == int.Parse(selectedCategoria)) && (!disponivel || p.Disponivel));

    private IEnumerable<Produto> paginatedProdutos => filteredProdutos
        .Skip((currentPage - 1) * pageSize)
        .Take(pageSize);

    private void PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            StateHasChanged();
        }
    }

    private void NextPage()
    {
        if (currentPage < totalPages)
        {
            currentPage++;
            StateHasChanged();
        }
    }

    private bool CanGoToPreviousPage => currentPage > 1;
    private bool CanGoToNextPage => currentPage < totalPages;

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
