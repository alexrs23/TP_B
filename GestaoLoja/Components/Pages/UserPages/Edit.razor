@page "/utilizadores/edit"
@using GestaoLoja.Data
@inject ApplicationDbContext DbContext
@inject NavigationManager Navigation

<PageTitle>Editar Utilizador</PageTitle>

<h3>Editar</h3>

<EditForm method="put" Model="user" OnValidSubmit="HandleValidSubmit" FormName="edit" Enhance>
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="form-group">
        <label for="Nome">Nome</label>
        <InputText id="Nome" class="form-control" @bind-Value="user.Nome" />
    </div>
    <div class="form-group">
        <label for="Apelido">Apelido</label>
        <InputText id="Apelido" class="form-control" @bind-Value="user.Apelido" />
    </div>
    <div class="form-group">
        <label for="Email">Email</label>
        <InputText id="Email" class="form-control" @bind-Value="user.Email" />
    </div>
    <div class="form-group">
        <label for="UserName">UserName</label>
        <InputText id="UserName" class="form-control" @bind-Value="user.UserName" />
    </div>
    <div class="form-group">
        <label for="PhoneNumber">PhoneNumber</label>
        <InputText id="PhoneNumber" class="form-control" @bind-Value="user.PhoneNumber" />
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a href="/utilizadores" class="btn btn-secondary">Cancel</a>
</EditForm>

@code {
    [SupplyParameterFromQuery]
    public string Id { get; set; }


    [SupplyParameterFromForm]
    private ApplicationUser user { get; set; }

    protected override async Task OnInitializedAsync()
    {
        user = await DbContext.Users.FindAsync(Id.ToString());
    }

    private async Task HandleValidSubmit()
    {
        DbContext.Users.Update(user);
        await DbContext.SaveChangesAsync();
        Navigation.NavigateTo("/utilizadores");
    }
}
