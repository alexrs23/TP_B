    @using RCLAPI.DTO
    @using Microsoft.AspNetCore.Components

    @inject NavigationManager NavigationManager

    @if (categoria?.UrlImagem is not null)
    {
        <div title="@categoria.Nome" class="card" style="background-image:url(@categoria.UrlImagem) @marginLeft position:center">
            <div>
                <p>@categoria.Nome</p>
            </div>
            <div class="footer-button">
                <a href="" @onclick='(() => Navega(categoria))'> <img alt="Pesquisar categoria" src="images/searchredicon50x50.png" width="30" /></a>
            </div>
        </div>
    }